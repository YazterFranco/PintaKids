{
  "name": "pintakids",
  "version": "2.0.0",
  "private": true,
  "description": "Pintakids — PWA infantil de dibujo y coloreado. Despliegue web en Cloudflare Pages.",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/src/server.ts",
    "test": "npm --prefix server test",
    "cf:build": "node cloudflare/build.mjs",
    "cf:preview": "npm run cf:build && wrangler dev --port 8788",
    "cf:deploy": "npm run cf:build && wrangler deploy"
  }
}
